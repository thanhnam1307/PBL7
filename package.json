{
  "name": "da-nang-satellite-land-classification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "sh -c '(cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8000) & (cd frontend && npm start) & wait'",
    "start:backend": "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "start:frontend": "cd frontend && npm start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .venv/bin/python -m pytest tests",
    "test:frontend": "cd frontend && CI=true npm test -- --watchAll=false",
    "build": "cd frontend && npm run build"
  }
}
